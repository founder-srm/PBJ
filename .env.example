# Copy to .env.local and fill in. Values come from the Neon project "PBJ".
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/pbj?sslmode=require
NEON_AUTH_BASE_URL=https://ENDPOINT.neonauth.REGION.aws.neon.tech/pbj/auth
# openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# Razorpay → Settings → Webhooks: the secret you set for the /api/razorpay/webhook endpoint (event: payment.captured)
RAZORPAY_WEBHOOK_SECRET=
